---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {getCollection} from 'astro:content';
import {getTags} from '../lib/tags';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = await getCollection('docs', (e) => !e.data.draft);
const count = (prefix: string) => docs.filter((d) => d.id.startsWith(prefix)).length;
const tags = await getTags();
const problems = count('docs/codes/');

const tracks = [
  {title: 'LeetCode sheets', note: 'Striver SDE · DP · Blind 75', meta: `${problems} problems`, href: `${base}/docs/leetcode/`},
  {title: 'DSA fundamentals', note: 'Bits, number theory, trees', meta: `${count('docs/dsa/')} articles`, href: `${base}/docs/dsa/`},
  {
    title: 'System design',
    note: 'How real products scale',
    meta: count('system-design/case-studies/') > 0 ? `${count('system-design/case-studies/')} case studies` : 'New',
    href: `${base}/system-design/`,
  },
  {
    title: 'Project Euler+',
    note: 'Maths-heavy challenges',
    meta: `${docs.filter((d) => d.id.startsWith('docs/project-euler/') && d.id !== 'docs/project-euler').length} problems`,
    href: `${base}/docs/project-euler/`,
  },
];

const topics = tags.slice(0, 10);

const description = `${problems} DSA interview problems from the Striver SDE sheet and Blind 75, each explained step by step with C++, Java and Python solutions tested against brute force.`;
const siteUrl = new URL(`${base}/`, Astro.site).href;

// Tells search engines and AI answers exactly which "CodePrime" this is, and who makes it.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'CodePrime',
      alternateName: ['Code Prime', 'CodePrime by Umang Kumar'],
      url: siteUrl,
      description,
      inLanguage: 'en',
      publisher: {'@id': 'https://umangkumarr.github.io/#person'},
    },
    {
      '@type': 'LearningResource',
      '@id': `${siteUrl}#resource`,
      name: 'CodePrime',
      url: siteUrl,
      description,
      learningResourceType: ['Tutorial', 'Practice problems'],
      educationalLevel: 'Intermediate',
      teaches: ['Data structures', 'Algorithms', 'Coding interview preparation'],
      programmingLanguage: ['C++', 'Java', 'Python'],
      isAccessibleForFree: true,
      license: 'https://opensource.org/licenses/MIT',
      image: `${siteUrl}og.png`,
      author: {'@id': 'https://umangkumarr.github.io/#person'},
      sameAs: ['https://github.com/umangkumarr/CodePrime'],
    },
    {
      '@type': 'Person',
      '@id': 'https://umangkumarr.github.io/#person',
      name: 'Umang Kumar',
      url: 'https://umangkumarr.github.io/',
      sameAs: ['https://github.com/umangkumarr'],
    },
  ],
};
---

<StarlightPage
  frontmatter={{
    title: 'DSA interview problems explained in C++, Java and Python',
    description,
    template: 'splash',
    pagefind: false,
    head: [{tag: 'script', attrs: {type: 'application/ld+json'}, content: JSON.stringify(structuredData)}],
  }}
  hasSidebar={false}
>
  <div class="home not-content">
    <section class="hero">
      <div class="hero__copy">
        <h1 class="hero__title">Learn the pattern,<br />not the answer.</h1>
        <p class="hero__lead">{problems} interview problems, each explained step by step with C++, Java and Python solutions tested against brute force.</p>
        <div class="actions">
          <a class="btn btn--primary" href={`${base}/docs/leetcode/`}>Start solving</a>
          <button type="button" class="btn btn--secondary" data-open-search>
            Search problems <kbd>⌘K</kbd>
          </button>
        </div>
      </div>

      <a class="demo" href={`${base}/docs/codes/trapping-rain-water/`}>
        <picture>
          <source media="(prefers-reduced-motion: reduce)" srcset={`${base}/img/home/trapping-rain-water-still.png`} />
          <img
            src={`${base}/img/codes/trapping-rain-water/two-pointers.gif`}
            width="672"
            height="418"
            alt="Animated walkthrough: two pointers move inwards over the bars of Trapping Rain Water, filling water one step at a time."
          />
        </picture>
        <span class="demo__caption">Trapping Rain Water, step by step <span aria-hidden="true">→</span></span>
      </a>
    </section>

    <section class="section" aria-labelledby="tracks-title">
      <h2 id="tracks-title" class="section__title">Choose a track</h2>
      <ul class="tracks">
        {
          tracks.map((t) => (
            <li>
              <a class="track" href={t.href}>
                <span class="track__title">{t.title}</span>
                <span class="track__note">{t.note}</span>
                <span class="track__meta">{t.meta}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="topics-title">
      <h2 id="topics-title" class="section__title">Practise by topic</h2>
      <ul class="topics">
        {
          topics.map((t) => (
            <li>
              <a href={`${base}/docs/tags/${t.slug}/`}>
                {t.label} <span class="topics__count">{t.entries.length}</span>
              </a>
            </li>
          ))
        }
        <li><a class="topics__all" href={`${base}/docs/tags/`}>All topics</a></li>
      </ul>
    </section>

    <footer class="foot">
      <span>Free and open source.</span>
      <a href={`${base}/contribute/`}>Contribute</a>
      <a href="https://github.com/umangkumarr/CodePrime">GitHub</a>
      <a href="https://umangkumarr.github.io/AI-Snake/">AI Snake</a>
      <a href="https://umangkumarr.github.io/AI-Minesweeper/">AI Minesweeper</a>
    </footer>
  </div>
</StarlightPage>

<script>
  // "Search problems" opens Starlight's own search dialog, the same one as the header and ⌘K.
  // Open after this click finishes: Starlight closes the dialog on any click outside it, including this one.
  document.querySelector('[data-open-search]')?.addEventListener('click', () => {
    setTimeout(() => document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click());
  });
</script>

<style>
  /* Starlight's splash template constrains width; the homepage manages its own. */
  :global(main:has(.home)) {
    padding-bottom: 0;
  }
  :global(.content-panel:has(.home)) {
    padding: 0;
    border: none;
  }
  :global(.content-panel:has(.home) > .sl-container) {
    max-width: none;
  }
  :global(.content-panel:has(.home) h1#_top) {
    display: none;
  }

  .home {
    --pad: clamp(1rem, 5vw, 3rem);
    max-width: 72rem;
    margin-inline: auto;
    padding: 0 var(--pad);
    font-size: 1rem;
  }
  .home :is(h1, h2, p, ul) {
    margin: 0;
  }

  /* Hero: one statement, one sentence, two actions, one real example. */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    padding: clamp(2.5rem, 8vw, 6rem) 0 clamp(2.5rem, 6vw, 4.5rem);
  }
  .hero__title {
    font-family: var(--cp-font-display);
    font-weight: 750;
    font-size: clamp(2.3rem, 4.6vw, 3.6rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
  }
  .hero__lead {
    margin-top: 1.25rem !important;
    max-width: 30rem;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--cp-text-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem; /* 44px target */
    padding: 0 1.3rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 150ms ease, border-color 150ms ease;
  }
  .btn--primary {
    background: var(--cp-accent);
    color: var(--cp-accent-ink);
  }
  .btn--primary:hover {
    background: var(--cp-accent-hover);
  }
  .btn--secondary {
    background: none;
    border-color: var(--cp-border-strong);
    color: var(--sl-color-white);
  }
  .btn--secondary:hover {
    border-color: var(--cp-muted);
  }
  .btn kbd {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--cp-muted);
  }
  @media (hover: none) {
    .btn kbd {
      display: none;
    }
  }
  .btn:focus-visible,
  .home a:focus-visible {
    outline: 2px solid var(--cp-accent);
    outline-offset: 3px;
  }

  .demo {
    display: block;
    text-decoration: none;
  }
  .demo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--cp-radius-lg);
    border: 1px solid var(--cp-border);
    box-shadow: var(--cp-shadow-lg);
  }
  .demo__caption {
    display: inline-block;
    margin-top: 0.85rem;
    font-size: 0.9rem;
    color: var(--cp-muted);
  }
  .demo:hover .demo__caption {
    color: var(--sl-color-white);
  }

  /* Sections */
  .section {
    padding: clamp(1.75rem, 4vw, 2.5rem) 0;
    border-top: 1px solid var(--cp-border);
  }
  .section__title {
    font-family: var(--cp-font-display);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
    margin-bottom: 1.25rem !important;
  }

  .tracks {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }
  .track {
    display: grid;
    gap: 0.25rem;
    height: 100%;
    padding: 1.1rem 1.2rem;
    border-radius: var(--cp-radius);
    border: 1px solid var(--cp-border);
    background: var(--cp-surface);
    text-decoration: none;
    transition: border-color 150ms ease;
  }
  .track:hover {
    border-color: var(--cp-border-strong);
  }
  .track__title {
    font-weight: 650;
    font-size: 1.02rem;
    color: var(--sl-color-white);
  }
  .track__note {
    font-size: 0.88rem;
    color: var(--cp-text-2);
  }
  .track__meta {
    margin-top: 0.6rem;
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    color: var(--cp-muted);
  }

  .topics {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .topics a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.5rem;
    padding: 0 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--cp-border);
    color: var(--cp-text-2);
    font-size: 0.9rem;
    text-decoration: none;
  }
  .topics a:hover {
    border-color: var(--cp-border-strong);
    color: var(--sl-color-white);
  }
  .topics__count {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--cp-muted);
  }
  .topics .topics__all {
    border-style: dashed;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    padding: 1.5rem 0 2.5rem;
    border-top: 1px solid var(--cp-border);
    font-size: 0.88rem;
    color: var(--cp-muted);
  }
  .foot a {
    color: var(--cp-text-2);
    text-decoration: none;
  }
  .foot a:hover {
    color: var(--sl-color-white);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
    .tracks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 30rem) {
    .tracks {
      grid-template-columns: minmax(0, 1fr);
    }
    .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .btn,
    .track {
      transition: none;
    }
  }
</style>
