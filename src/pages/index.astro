---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {Code} from '@astrojs/starlight/components';
import {getCollection} from 'astro:content';
import {getTags} from '../lib/tags';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const docs = await getCollection('docs', (e) => !e.data.draft);
const count = (prefix: string) => docs.filter((d) => d.id.startsWith(prefix)).length;
const tags = await getTags();
const topics = tags.slice(0, 18);
const maxTopic = topics[0]?.entries.length ?? 1;

const stats = {
  problems: count('docs/codes/'),
  dsa: count('docs/dsa/'),
  euler: docs.filter((d) => d.id.startsWith('docs/project-euler/') && d.id !== 'docs/project-euler').length,
  interviews: docs.filter((d) => d.id.startsWith('docs/interviews/')).length,
  caseStudies: count('system-design/case-studies/'),
};

const heroCode = `int trap(vector<int>& height) {
    int n = height.size();
    int ans = 0, sm = height[0];
    int mx = height[0], indx = 0;
    for (int i = 1; i < n; i++) {
        sm += height[i];
        if (mx < height[i]) { mx = height[i]; indx = i; }
    }
    mx = 0;
    ans = height[indx];
    for (int i = 0; i < indx; i++)
        if (mx < height[i]) {
            ans += (indx - i) * (height[i] - mx);
            mx = height[i];
        }
    // ...mirror sweep from the right...
    return ans - sm;
}`;

const tracks = [
  {
    index: '01',
    title: 'LeetCode sheets',
    body: 'Striver SDE, Striver DP and Blind 75 — every problem solved and explained step by step.',
    href: `${base}/docs/leetcode/`,
    meta: `${stats.problems} problems`,
  },
  {
    index: '02',
    title: 'DSA fundamentals',
    body: 'Bit manipulation, number theory and trees — the building blocks behind every clever solution.',
    href: `${base}/docs/dsa/`,
    meta: `${stats.dsa} articles`,
  },
  {
    index: '03',
    title: 'System design',
    body: 'How real products work end to end, what broke as they scaled, and how it was fixed.',
    href: `${base}/system-design/`,
    meta: stats.caseStudies > 0 ? `${stats.caseStudies} case studies` : 'New',
  },
  {
    index: '04',
    title: 'Project Euler+',
    body: 'Mathematical programming challenges where brute force fails and insight wins.',
    href: `${base}/docs/project-euler/`,
    meta: `${stats.euler} problems`,
  },
];

const steps = [
  {n: '1', title: 'Read the problem', body: 'The full statement on the page, with a direct link to the original problem so you can submit.'},
  {n: '2', title: 'Understand the approach', body: 'Intuition, a step-by-step algorithm, time and space complexity, and the edge cases that trip people up.'},
  {n: '3', title: 'Reveal the code', body: 'Solutions stay hidden until you are ready, so you get a fair attempt first. Mark problems solved as you go.'},
];

const projects = [
  {title: 'AI Snake', body: 'Watch an AI agent play the classic Snake game, live in your browser.', href: 'https://umangkumarr.github.io/AI-Snake/'},
  {title: 'AI Minesweeper', body: 'Watch an AI agent work its way through a Minesweeper board, move by move.', href: 'https://umangkumarr.github.io/AI-Minesweeper/'},
];
---

<StarlightPage
  frontmatter={{
    title: 'CodePrime',
    description: 'Data structures, algorithms, interview problems and system design — explained, solved and organised.',
    template: 'splash',
    pagefind: false,
  }}
  hasSidebar={false}
>
  <div class="home not-content">
    <section class="hero">
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="hero__inner">
        <div class="hero__copy">
          <p class="eyebrow"><span class="pulse" aria-hidden="true"></span>Open-source · {stats.problems}+ explained problems</p>
          <h1 class="hero__title">Think in <em>patterns</em>,<br />not memorised answers.</h1>
          <p class="hero__lead">
            CodePrime is a free, structured library of algorithms, interview problems and system design — each
            with the reasoning, the complexity, and clean code you can read in a minute.
          </p>
          <div class="actions">
            <a class="btn btn--primary" href={`${base}/docs/leetcode/`}>Start solving <span aria-hidden="true">→</span></a>
            <a class="btn btn--ghost" href={`${base}/system-design/`}>Explore system design</a>
          </div>
          <dl class="hero__meta">
            <div><dt>Sheets</dt><dd>Striver SDE · DP · Blind 75</dd></div>
            <div><dt>Every solution has</dt><dd>Intuition · Algorithm · Complexity</dd></div>
          </dl>
        </div>

        <figure class="card" aria-label="Example solution page">
          <div class="card__chrome"><span></span><span></span><span></span><span class="card__file">trapping-rain-water.md</span></div>
          <div class="card__body">
            <div class="card__head">
              <h2>Trapping Rain Water</h2>
              <span class="diff">Hard</span>
            </div>
            <div class="chips"><span>Array</span><span>Two Pointers</span><span>Stack</span></div>
            <div class="cx">
              <div><span>Time</span><strong>O(n)</strong></div>
              <div><span>Space</span><strong>O(1)</strong></div>
              <div><span>Pattern</span><strong>Layer sweep</strong></div>
            </div>
            <div class="card__code"><Code code={heroCode} lang="cpp" title="C++" /></div>
            <a class="card__link" href={`${base}/docs/codes/trapping-rain-water/`}>Read the full walkthrough →</a>
          </div>
        </figure>
      </div>
    </section>

    <section class="stats" aria-label="Library at a glance">
      <div><strong>{stats.problems}</strong><span>Explained problems</span></div>
      <div><strong>{tags.length}</strong><span>Topics</span></div>
      <div><strong>{stats.dsa}</strong><span>Concept deep-dives</span></div>
      <div><strong>{stats.interviews}</strong><span>Company lists</span></div>
    </section>

    <section class="section">
      <header class="section__head">
        <p class="kicker">Tracks</p>
        <h2>Pick a path. Go deep.</h2>
        <p>Each track is ordered so that every page builds on the one before it.</p>
      </header>
      <div class="tracks">
        {
          tracks.map((t) => (
            <a class="track" href={t.href}>
              <div class="track__top">
                <span class="track__index">{t.index}</span>
                <span class="track__meta">{t.meta}</span>
              </div>
              <h3>{t.title}</h3>
              <p>{t.body}</p>
              <span class="track__cta">Explore →</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section section--alt">
      <header class="section__head">
        <p class="kicker">How every problem page works</p>
        <h2>Built for practice, not for skimming.</h2>
      </header>
      <ol class="steps">
        {
          steps.map((s) => (
            <li class="step">
              <span class="step__n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="section">
      <header class="section__head">
        <p class="kicker">Browse by topic</p>
        <h2>Practise the pattern you are weakest at.</h2>
      </header>
      <ul class="topics">
        {
          topics.map((t) => (
            <li>
              <a href={`${base}/docs/tags/${t.slug}/`}>
                <span class="topics__label">{t.label}</span>
                <span class="topics__bar" aria-hidden="true"><span style={`width:${Math.max(8, (t.entries.length / maxTopic) * 100)}%`} /></span>
                <span class="topics__count">{t.entries.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="more" href={`${base}/docs/tags/`}>See all topics →</a>
    </section>

    <section class="section section--alt">
      <header class="section__head">
        <p class="kicker">Projects</p>
        <h2>Algorithms, in motion.</h2>
      </header>
      <div class="projects">
        {
          projects.map((p) => (
            <a class="project" href={p.href}>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
              <span class="track__cta">Play live →</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="cta">
      <div class="cta__inner">
        <div>
          <h2>Solved something elegantly?</h2>
          <p>
            CodePrime is open source. Add a solution, improve an explanation, or write up a system design case study —
            every pull request helps the next person preparing for their interview.
          </p>
        </div>
        <div class="actions">
          <a class="btn btn--primary" href={`${base}/contribute/`}>Contribution guide →</a>
          <a class="btn btn--ghost" href="https://github.com/umangkumarr/CodePrime">Star on GitHub</a>
        </div>
      </div>
    </section>
  </div>
</StarlightPage>

<style>
  /* Starlight's splash template constrains width; the homepage manages its own. */
  :global(main:has(.home)) {
    padding-bottom: 0;
  }
  :global(.content-panel:has(.home)) {
    padding: 0;
    border: none;
  }
  :global(.content-panel:has(.home) > .sl-container) {
    max-width: none;
  }
  :global(.content-panel:has(.home) h1#_top) {
    display: none;
  }

  .home {
    --pad: clamp(1rem, 4vw, 3rem);
    --max: 76rem;
    font-size: 1rem;
  }
  .home > section > *,
  .hero__inner {
    max-width: var(--max);
    margin-inline: auto;
  }
  .home h2,
  .home h3 {
    font-family: var(--cp-font-display);
    color: var(--sl-color-white);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .home p {
    margin: 0;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.9rem;
    padding: 0 1.35rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease, transform 160ms ease;
  }
  .btn--primary {
    background: var(--cp-accent);
    color: var(--cp-accent-ink);
  }
  .btn--primary:hover {
    background: var(--cp-accent-hover);
    transform: translateY(-1px);
  }
  .btn--ghost {
    border: 1px solid var(--cp-border-strong);
    color: var(--sl-color-white);
  }
  .btn--ghost:hover {
    border-color: var(--sl-color-white);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(3.5rem, 8vw, 6rem) var(--pad) clamp(3.5rem, 7vw, 5.5rem);
    border-bottom: 1px solid var(--cp-border);
  }
  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(var(--cp-grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--cp-grid) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(ellipse 70% 70% at 70% 30%, #000 20%, transparent 75%);
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    width: 560px;
    height: 560px;
    right: -120px;
    top: -200px;
    background: radial-gradient(circle, var(--cp-accent-soft), transparent 65%);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 4rem;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--cp-text-2);
    border: 1px solid var(--cp-border-strong);
    background: var(--cp-surface);
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    margin-bottom: 1.75rem !important;
  }
  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cp-teal);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 var(--cp-teal-soft); }
    70% { box-shadow: 0 0 0 8px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  .hero__title {
    font-family: var(--cp-font-display);
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: var(--sl-color-white);
    margin: 0 0 1.5rem;
  }
  .hero__title em {
    font-style: normal;
    color: var(--cp-accent);
    background: linear-gradient(transparent 82%, var(--cp-accent-soft) 82%);
  }
  .hero__lead {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--cp-text-2);
    max-width: 34rem;
    margin-bottom: 2.25rem !important;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin: 2.75rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--cp-border-strong);
    max-width: 34rem;
  }
  .hero__meta dt {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cp-muted);
    margin-bottom: 0.25rem;
  }
  .hero__meta dd {
    margin: 0;
    font-weight: 500;
    color: var(--sl-color-white);
    font-size: 0.95rem;
  }

  .card {
    margin: 0;
    min-width: 0;
    background: var(--cp-surface);
    border: 1px solid var(--cp-border-strong);
    border-radius: var(--cp-radius-lg);
    box-shadow: var(--cp-shadow-lg);
    overflow: hidden;
    transform: rotate(0.6deg);
    transition: transform 300ms ease;
  }
  .card:hover {
    transform: rotate(0deg) translateY(-2px);
  }
  .card__chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--cp-border);
    background: var(--cp-surface-2);
  }
  .card__chrome > span:not(.card__file) {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--cp-border-strong);
  }
  .card__file {
    font-family: var(--sl-font-mono);
    margin-left: 0.6rem;
    background: none;
    padding: 0;
    font-size: 0.75rem;
    color: var(--cp-muted);
  }
  .card__body {
    padding: 1.35rem 1.4rem 1.2rem;
  }
  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .card__head h2 {
    font-size: 1.25rem;
  }
  .diff {
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--cp-red);
    background: color-mix(in srgb, var(--cp-red) 12%, transparent);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .chips span {
    font-size: 0.75rem;
    color: var(--cp-text-2);
    border: 1px solid var(--cp-border-strong);
    border-radius: 999px;
    padding: 0.1rem 0.6rem;
  }
  .cx {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--cp-border);
    border-radius: var(--cp-radius-sm);
    margin-bottom: 1rem;
  }
  .cx > div {
    display: flex;
    flex-direction: column;
    padding: 0.55rem 0.8rem;
    min-width: 0;
  }
  .cx > div + div {
    border-left: 1px solid var(--cp-border);
  }
  .cx span {
    font-family: var(--sl-font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cp-muted);
  }
  .cx strong {
    font-family: var(--sl-font-mono);
    font-size: 0.9rem;
    color: var(--cp-teal);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .card__code {
    margin-bottom: 1rem;
    font-size: 0.8rem;
  }
  .card__code :global(pre) {
    max-height: 250px;
  }
  .card__link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--cp-accent);
    text-decoration: none;
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--cp-border);
    max-width: none !important;
    padding-inline: max(var(--pad), calc((100% - var(--max)) / 2));
  }
  .stats > div {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 2rem 1.5rem;
  }
  .stats > div + div {
    border-left: 1px solid var(--cp-border);
  }
  .stats strong {
    font-family: var(--cp-font-display);
    font-size: clamp(2rem, 4vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--sl-color-white);
    font-variant-numeric: tabular-nums;
  }
  .stats span {
    color: var(--cp-muted);
    font-size: 0.9rem;
  }

  /* Sections */
  .section {
    padding: clamp(3.5rem, 8vw, 6rem) var(--pad);
  }
  .section--alt {
    background: var(--cp-bg-soft);
    border-block: 1px solid var(--cp-border);
  }
  .section__head {
    margin-bottom: 3rem;
  }
  .section__head > * {
    max-width: 40rem;
  }
  .section__head h2 {
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  .section__head p:not(.kicker) {
    color: var(--cp-muted);
    font-size: 1.05rem;
  }
  .kicker {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cp-accent);
    margin-bottom: 0.85rem !important;
  }

  .tracks,
  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .track,
  .project {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    background: var(--cp-surface);
    border: 1px solid var(--cp-border);
    border-radius: var(--cp-radius-lg);
    color: inherit;
    text-decoration: none;
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }
  .track:hover,
  .project:hover {
    border-color: var(--cp-accent);
    transform: translateY(-3px);
    box-shadow: var(--cp-shadow);
  }
  .track__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2.5rem;
  }
  .track__index {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    color: var(--cp-muted);
  }
  .track__meta {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    color: var(--cp-accent);
    background: var(--cp-accent-soft);
    border-radius: 999px;
    padding: 0.25rem 0.7rem;
  }
  .track h3,
  .project h3 {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }
  .track p,
  .project p {
    color: var(--cp-muted);
    flex: 1;
    margin-bottom: 1.5rem;
  }
  .track__cta {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--cp-accent);
  }
  .project {
    justify-content: space-between;
    min-height: 12rem;
    background: radial-gradient(circle at 100% 0%, var(--cp-accent-soft), transparent 55%), var(--cp-surface);
  }

  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .step {
    margin: 0;
    padding: 1.75rem;
    border-radius: var(--cp-radius-lg);
    background: var(--cp-surface);
    border: 1px solid var(--cp-border);
  }
  .step__n {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    font-family: var(--sl-font-mono);
    font-weight: 600;
    background: var(--cp-accent-soft);
    color: var(--cp-accent);
    margin-bottom: 1.25rem;
  }
  .step h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .step p {
    color: var(--cp-muted);
    font-size: 0.95rem;
  }

  .topics {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2rem;
  }
  .topics li {
    margin: 0;
  }
  .topics a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 5rem 2.5rem;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0.25rem;
    border-bottom: 1px solid var(--cp-border);
    color: var(--cp-text-2);
    text-decoration: none;
  }
  .topics a:hover {
    color: var(--sl-color-white);
  }
  .topics__label {
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .topics__bar {
    height: 4px;
    border-radius: 999px;
    background: var(--cp-border);
    overflow: hidden;
  }
  .topics__bar span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--cp-muted);
    transition: background-color 160ms ease;
  }
  .topics a:hover .topics__bar span {
    background: var(--cp-accent);
  }
  .topics__count {
    font-family: var(--sl-font-mono);
    font-size: 0.85rem;
    color: var(--cp-muted);
    text-align: right;
  }
  .more {
    display: block;
    margin-top: 2rem;
    font-weight: 600;
    color: var(--cp-accent);
    text-decoration: none;
