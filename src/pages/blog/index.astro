---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {getCollection} from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('docs', (e) => e.id.startsWith('blog/') && !e.data.draft)).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
);
const fmt = new Intl.DateTimeFormat('en', {year: 'numeric', month: 'long', day: 'numeric'});
---

<StarlightPage
  frontmatter={{title: 'Blog', description: 'Notes on learning algorithms, interview preparation and engineering.', tableOfContents: false}}
>
  <div class="cp-posts not-content">
    {
      posts.map((p) => (
        <a class="cp-post" href={`${base}/${p.id}/`}>
          {p.data.date && <time datetime={p.data.date.toISOString()}>{fmt.format(p.data.date)}</time>}
          <h2>{p.data.title}</h2>
          {p.data.description && <p>{p.data.description}</p>}
          <span class="cp-post__more">Read post →</span>
        </a>
      ))
    }
  </div>
</StarlightPage>

<style>
  .cp-posts {
    display: grid;
    gap: 1rem;
  }
  .cp-post {
    display: block;
    padding: 1.6rem 1.75rem;
    border: 1px solid var(--cp-border);
    border-radius: var(--cp-radius-lg);
    background: var(--cp-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 160ms ease, transform 160ms ease;
  }
  .cp-post:hover {
    border-color: var(--cp-accent);
    transform: translateY(-2px);
  }
  .cp-post time {
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    color: var(--cp-muted);
  }
  .cp-post h2 {
    font-family: var(--cp-font-display);
    font-size: 1.4rem;
    margin: 0.4rem 0 0.5rem;
    color: var(--sl-color-white);
  }
  .cp-post p {
    color: var(--cp-text-2);
    margin: 0 0 1rem;
  }
  .cp-post__more {
    font-weight: 600;
    color: var(--cp-accent);
  }
</style>
