---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import {getTags, type TagInfo} from '../../../lib/tags';

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map((tag) => ({params: {tag: tag.slug}, props: {tag}}));
}

const {tag} = Astro.props as {tag: TagInfo};
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<StarlightPage
  frontmatter={{
    title: tag.label,
    description: `${tag.entries.length} problems on CodePrime that practise ${tag.label}.`,
    tableOfContents: false,
  }}
>
  <p>
    {tag.entries.length} problem{tag.entries.length === 1 ? '' : 's'} tagged <strong>{tag.label}</strong>.
    <a href={`${base}/docs/tags/`}>All topics →</a>
  </p>
  <ul class="cp-list not-content">
    {
      tag.entries.map((e) => (
        <li>
          <a href={`${base}/${e.id}/`}>
            <span>{e.data.title}</span>
            <span class="cp-list__meta">{e.data.tags.filter((t) => t !== tag.label).slice(0, 2).join(' · ')}</span>
          </a>
        </li>
      ))
    }
  </ul>
</StarlightPage>
