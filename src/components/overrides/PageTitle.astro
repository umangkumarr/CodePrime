---
import Default from '@astrojs/starlight/components/PageTitle.astro';
import ProblemHeader from '../ProblemHeader.astro';

const {data} = Astro.locals.starlightRoute.entry;
const isHome = Astro.url.pathname.replace(/\/$/, '') === import.meta.env.BASE_URL.replace(/\/$/, '');
---

{!isHome && <Default />}
{data.source && <ProblemHeader />}
